# =============================================================
# Accounting Module — Environment Variables (Supabase MVP)
# Copy to .env.local and fill in values from Supabase dashboard
# =============================================================

# ── Supabase Project ──────────────────────────────────────────
# Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-public-key>
SUPABASE_SERVICE_ROLE_KEY=<service-role-secret-key>

# ── Database (Prisma) ─────────────────────────────────────────
# Settings → Database → Connection string → Transaction mode (port 6543) — for runtime queries
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1

# Settings → Database → Connection string → Session mode (port 5432) — for migrations / prisma db push
DIRECT_URL=postgresql://postgres.<project-ref>:<password>@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres

# ── App ──────────────────────────────────────────────────────
NEXTAUTH_URL=http://localhost:3007
NEXTAUTH_SECRET=change-me-in-production

# ── Tenant (single-tenant MVP) ───────────────────────────────
TENANT_ID=HTX_DEFAULT
